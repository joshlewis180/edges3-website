# /etc/systemd/system/edges-pipeline.service
# Option B part 1: oneshot service that runs the daily pipeline.
# Triggered by edges-pipeline.timer (NOT started directly).
#
# If you use this option, set EDGES_DAEMON_ENABLED=0 in edges-api.service
# so the in-process scheduler is disabled — otherwise the pipeline runs
# twice per day.

[Unit]
Description=EDGES-3 daily analysis pipeline
After=network-online.target

[Service]
Type=oneshot
User=edges
Group=edges
WorkingDirectory=/opt/edges-interface
Environment="PATH=/opt/anaconda3/envs/edges/bin:/usr/local/bin:/usr/bin:/bin"

ExecStart=/opt/edges-interface/scripts/edges-pipeline.sh

# Send output to journal so you can `journalctl -u edges-pipeline`
StandardOutput=journal
StandardError=journal
