# /etc/systemd/system/edges-api.service
# Option A: long-running uvicorn process with the in-process scheduler
#           enabled (EDGES_DAEMON_ENABLED=1). The daemon runs inside
#           uvicorn at EDGES_DAEMON_HOUR (UTC) every day.
#
# Install:
#   sudo cp edges-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now edges-api.service
#   sudo journalctl -u edges-api.service -f

[Unit]
Description=EDGES-3 backend API (uvicorn)
Documentation=https://github.com/<you>/edges-interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edges
Group=edges
WorkingDirectory=/opt/edges-interface
Environment="PATH=/opt/anaconda3/envs/edges/bin:/usr/local/bin:/usr/bin:/bin"
Environment="EDGES_RAW_DATA_ROOT=/data5/edges/data/EDGES3_data/MRO"
Environment="EDGES_OUTPUT_ROOT=/data5/edges/edges_outputs"
Environment="EDGES_TEMP_LOG_DIR=/data5/edges/data/EDGES3_data/MRO/temperature_logger"
Environment="EDGES_BEAM_FACTOR_FILE=/data5/edges/e3_beam_factor.hickle"
Environment="EDGES_DAEMON_ENABLED=1"
Environment="EDGES_DAEMON_HOUR=2"

ExecStart=/opt/anaconda3/envs/edges/bin/python \
    -m uvicorn backend.backend_api:app \
    --host 0.0.0.0 --port 8000 --workers 1

Restart=on-failure
RestartSec=5

# Hardening (optional but recommended on a shared box)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/data5/edges/edges_outputs
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
